[Unit]
Description=Apply the Mocha Bluetooth RTS startup sequence
After=local-fs.target mocha-desktop-hardware.service
Before=bluetooth.service
ConditionKernelVersion=6.12.111-moze.1-native-vde2
ConditionPathExists=/run/mocha-desktop-vde.requested

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/mocha-bluetooth-hardware
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
