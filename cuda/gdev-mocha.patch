 void __nouveau_fifo_kick(struct gdev_ctx *ctx)
 {
-	struct nouveau_pushbuf *push = (struct nouveau_pushbuf *)ctx->pctx;
-	nouveau_pushbuf_kick(push, push->channel);
+    struct nouveau_pushbuf *push = (struct nouveau_pushbuf *)ctx->pctx;
+    struct nouveau_bufctx *bufctx = push->user_priv;
+    struct gdev_mem *mem;
+    /* Keep code, data and local memory resident for this submission. */
+    nouveau_bufctx_reset(bufctx, 1);
+    gdev_list_for_each(mem, &ctx->vas->mem_list, list_entry_heap) {
+        struct nouveau_bo *bo = mem->bo;
+        nouveau_bufctx_refn(bufctx, 1, bo,
+            (bo->flags & (NOUVEAU_BO_GART | NOUVEAU_BO_VRAM)) | NOUVEAU_BO_RDWR);
+    }
+    gdev_list_for_each(mem, &ctx->vas->dma_mem_list, list_entry_heap) {
+        struct nouveau_bo *bo = mem->bo;
+        nouveau_bufctx_refn(bufctx, 1, bo, NOUVEAU_BO_GART | NOUVEAU_BO_RDWR);
+    }
+    if (nouveau_pushbuf_validate(push) || nouveau_pushbuf_kick(push, push->channel)) {
+        GDEV_PRINT("MOCHA_GPU_SUBMISSION_FAILED\n");
+        abort();
+    }
 }
 
