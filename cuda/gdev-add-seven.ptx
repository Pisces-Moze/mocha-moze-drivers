.version 4.1
.target sm_32
.address_size 64

.visible .entry add_seven(
    .param .u64 input_address,
    .param .u64 output_address,
    .param .u32 element_count
)
{
    .reg .pred %p;
    .reg .u32 %r<6>;
    .reg .u64 %rd<6>;
    ld.param.u64 %rd0, [input_address];
    ld.param.u64 %rd1, [output_address];
    ld.param.u32 %r0, [element_count];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r1, %r2, %r3, %r1;
    setp.ge.u32 %p, %r1, %r0;
    @%p bra DONE;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd0, %rd2;
    add.u64 %rd4, %rd1, %rd2;
    ld.global.u32 %r4, [%rd3];
    add.u32 %r5, %r4, 7;
    st.global.u32 [%rd4], %r5;
DONE:
    ret;
}
