diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/pmu/gk20a.c b/drivers/gpu/drm/nouveau/nvkm/subdev/pmu/gk20a.c
index b5e52b3..90f8b90 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/pmu/gk20a.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/pmu/gk20a.c
@@ -25,10 +25,25 @@
 #include <subdev/clk.h>
 #include <subdev/timer.h>
 #include <subdev/volt.h>
+#include <linux/moduleparam.h>
 
 #define BUSY_SLOT	0
 #define CLK_SLOT	7
 
+/* Keep the upstream policy by default; expose bounded tuning for display
+ * workloads whose vblank idle time otherwise hides missed frame deadlines.
+ * Frequency and voltage still use the existing fuse-limited pstate table.
+ */
+static int gk20a_load_target = 70;
+module_param_named(gk20a_load_target, gk20a_load_target, int, 0644);
+MODULE_PARM_DESC(gk20a_load_target, "GK20A DVFS target utilization (10-90 percent)");
+static int gk20a_load_max = 90;
+module_param_named(gk20a_load_max, gk20a_load_max, int, 0644);
+MODULE_PARM_DESC(gk20a_load_max, "GK20A DVFS fast-ramp utilization threshold");
+static int gk20a_poll_ms = 100;
+module_param_named(gk20a_poll_ms, gk20a_poll_ms, int, 0644);
+MODULE_PARM_DESC(gk20a_poll_ms, "GK20A DVFS sampling interval (10-1000 ms)");
+
 struct gk20a_pmu_dvfs_data {
 	int p_load_target;
 	int p_load_max;
@@ -67,18 +82,18 @@ static int
 gk20a_pmu_dvfs_get_target_state(struct gk20a_pmu *pmu,
 				int *state, int load)
 {
-	struct gk20a_pmu_dvfs_data *data = pmu->data;
 	struct nvkm_clk *clk = pmu->base.subdev.device->clk;
 	int cur_level, level;
+	int target = clamp(READ_ONCE(gk20a_load_target), 10, 90);
+	int load_max = clamp(READ_ONCE(gk20a_load_max), target, 100);
 
 	/* For GK20A, the performance level is directly mapped to pstate */
 	level = cur_level = clk->pstate;
 
-	if (load > data->p_load_max) {
+	if (load > load_max) {
 		level = min(clk->state_nr - 1, level + (clk->state_nr / 3));
 	} else {
-		level += ((load - data->p_load_target) * 10 /
-				data->p_load_target) / 2;
+		level += ((load - target) * 10 / target) / 2;
 		level = max(0, level);
 		level = min(clk->state_nr - 1, level);
 	}
@@ -151,7 +166,9 @@ gk20a_pmu_dvfs_work(struct nvkm_alarm *alarm)
 
 resched:
 	gk20a_pmu_dvfs_reset_dev_status(pmu);
-	nvkm_timer_alarm(tmr, 100000000, alarm);
+	nvkm_timer_alarm(tmr,
+		(u64)clamp(READ_ONCE(gk20a_poll_ms), 10, 1000) * 1000000,
+		alarm);
 }
 
 static void
